# GEMINI_API_KEY: Required for Gemini AI API calls (e.g., /api/ai/ask endpoint).
# Get yours at https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# WORKER_URL: The Cloudflare Worker D1 proxy URL.
# Used when USE_REMOTE_DB=true to route API calls to the remote database.
WORKER_URL="https://website.axontech254.workers.dev"

# USE_REMOTE_DB: Set to "true" to proxy all API calls to the Cloudflare Worker (D1).
# Set to "false" to use the local db.json file instead.
USE_REMOTE_DB="true"

# NODE_ENV: Set to "production" when deploying.
NODE_ENV="development"

# DISABLE_HMR: Set to "true" to disable Hot Module Replacement in Vite dev server.
DISABLE_HMR="false"
