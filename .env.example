# ============================================================
# AXON TECH — COMPLETE ENVIRONMENT VARIABLES GUIDE
# ============================================================
# HOW TO SET:
#   - LOCAL .dev.vars  → for `wrangler dev` (dev server)
#   - Cloudflare Secrets → for `wrangler deploy` (live site)
#     Run: npx wrangler secret put VARIABLE_NAME
#         then enter the value when prompted
# ============================================================

# ─────────────────────────────────────────────────────────────
# SECTION 1: MANDATORY — REQUIRED FOR THE SITE TO WORK
# ─────────────────────────────────────────────────────────────

# ADMIN_EMAIL
#   What: Email address for the super admin account
#   Set:  wrangler secret put ADMIN_EMAIL
#   Get:  env.ADMIN_EMAIL — used by seedSuperAdmin() on first login
#         to create/verify the super admin user in D1 DB
#   Note: Only used during seeding. Multiple admins can exist in DB.
ADMIN_EMAIL=axontech254@gmail.com,kamaustephenpaul@gmail.com

# ADMIN_PASSWORD
#   What: Password for the super admin account
#   Set:  wrangler secret put ADMIN_PASSWORD
#   Get:  env.ADMIN_PASSWORD — used by seedSuperAdmin() on first run
#   Note: Change password after first login via admin panel
ADMIN_PASSWORD=ChangeMe123!

# GEMINI_API_KEY
#   What: Google Gemini API key for AI-powered features
#   Set:  wrangler secret put GEMINI_API_KEY
#   Get:  env.GEMINI_API_KEY — used in:
#         - generateBlogPost() to auto-generate blog content
#         - generateReport() to auto-generate sales/catalog reports
#   Get yours: https://aistudio.google.com/app/apikey
#   Note: If not set, AI features return 400 error but site works fine
GEMINI_API_KEY=


# ─────────────────────────────────────────────────────────────
# SECTION 2: WHATSAPP BUSINESS API — OPTIONAL
# ─────────────────────────────────────────────────────────────
# Without these, orders are saved to DB but no WhatsApp messages are sent
# Setup guide: https://business.whatsapp.com/developers/developer-hub

# WHATSAPP_ACCESS_TOKEN
#   What: Meta-provided long-lived access token for WhatsApp Business API
#   Set:  wrangler secret put WHATSAPP_ACCESS_TOKEN
#   Get:  env.WHATSAPP_ACCESS_TOKEN — used in sendWhatsAppMessage()
#         to authenticate requests to Meta Graph API v21.0
#   How:  Meta Business Developer Console → WhatsApp → API Setup → Access Tokens
WHATSAPP_ACCESS_TOKEN=

# WHATSAPP_PHONE_NUMBER_ID
#   What: Your WhatsApp Business phone number ID
#   Set:  wrangler secret put WHATSAPP_PHONE_NUMBER_ID
#   Get:  env.WHATSAPP_PHONE_NUMBER_ID — used as the `from` number
#         in sendWhatsAppMessage() when sending messages via Meta Graph API
#   How:  Meta Business Developer Console → WhatsApp → API Setup → Phone Numbers
WHATSAPP_PHONE_NUMBER_ID=

# WHATSAPP_ADMIN_NOTIFY_NUMBER
#   What: Your admin WhatsApp number to receive new order alerts
#   Set:  wrangler secret put WHATSAPP_ADMIN_NOTIFY_NUMBER
#   Get:  env.WHATSAPP_ADMIN_NOTIFY_NUMBER — used in notifyOrderViaWhatsApp()
#         to send new order details to you (the shop owner)
#   Format: Kenyan format, no + sign, no spaces
#   Example: 254745017979
WHATSAPP_ADMIN_NOTIFY_NUMBER=254745017979


# ─────────────────────────────────────────────────────────────
# SECTION 3: FIREBASE — REQUIRED FOR GOOGLE SIGN-IN
# ─────────────────────────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → Your Apps → Web App
# https://console.firebase.google.com/project/axon-website-254/settings/general

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=axon-website-254.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=axon-website-254
VITE_FIREBASE_STORAGE_BUCKET=axon-website-254.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# FIREBASE_WEB_API_KEY (worker-side only — for ID token verification)
# Set: wrangler secret put FIREBASE_WEB_API_KEY
# Same value as VITE_FIREBASE_API_KEY above
FIREBASE_WEB_API_KEY=


# ─────────────────────────────────────────────────────────────
# SECTION 4: SECURITY — OPTIONAL
# ─────────────────────────────────────────────────────────────

# ADMIN_API_KEY
#   What: Secret API key for server-to-server authentication
#   Set:  wrangler secret put ADMIN_API_KEY
#   Get:  env.ADMIN_API_KEY — checked in verifyRequestSecurity()
#         If a request has header "x-admin-api-key: <value>" matching this,
#         it bypasses session auth (useful for internal VPS calls)
#   Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   Note: Optional. Leave empty if not needed.
ADMIN_API_KEY=

# ALLOWED_ADMIN_IPS
#   What: Comma-separated list of IPs allowed to access /api/admin/* endpoints
#   Set:  wrangler secret put ALLOWED_ADMIN_IPS
#   Get:  env.ALLOWED_ADMIN_IPS — checked in verifyRequestSecurity()
#         If not set (empty), admin endpoints accept requests from any IP
#         Rate limiting still applies to prevent brute force
#   Format: Comma-separated, no spaces. Supports partial matching.
#   Example: ALLOWED_ADMIN_IPS=197.232.45.10,10.0.0.1
#   Note: Optional. Leave empty to allow all IPs.
ALLOWED_ADMIN_IPS=


# ─────────────────────────────────────────────────────────────
# SECTION 5: AUTOMATIC — DO NOT SET
# ─────────────────────────────────────────────────────────────
# These are bound automatically by Wrangler. Do NOT set them.

# env.DB (D1Database)
#   What: Your Cloudflare D1 SQLite database binding
#   Set:  Automatically via wrangler.toml [[d1_databases]] binding
#   Get:  env.DB — used for ALL database operations throughout the worker
#   Config: See bottom of wrangler.toml — do NOT add here

# env.ASSETS (Assets)
#   What: Cloudflare Workers Assets binding for static file serving
#   Set:  Automatically by Workers framework
#   Get:  Used internally by the Workers runtime


# ─────────────────────────────────────────────────────────────
# SECTION 6: WRANGLER.TOML — THESE ARE DEFAULTS ONLY
# ─────────────────────────────────────────────────────────────
# The vars in wrangler.toml [vars] block are FALLBACK defaults
# that show in the dashboard. For SECRET values, always use
# `wrangler secret put` instead — secrets are never stored in
# wrangler.toml or committed to git.
#
# Current wrangler.toml [vars]:
#   ADMIN_EMAIL = "kamaustephenpaul@gmail.com"  (default placeholder)
#   ADMIN_PASSWORD = "39344323"                  (default placeholder)
#
# When you run `wrangler secret put ADMIN_EMAIL` it overrides
# the wrangler.toml default for the deployed worker.
