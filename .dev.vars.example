# ============================================================
# AXON TECH — Environment Variables for Local Development
# ============================================================
# Copy this file to .dev.vars and fill in your values.
# These are for LOCAL dev only (wrangler dev).
# For production (wrangler deploy), use:
#   npx wrangler secret put VARIABLE_NAME
# ============================================================

# ─── REQUIRED ────────────────────────────────────────────────

# Super admin credentials — used to seed the first admin user in D1
ADMIN_EMAIL=axontech254@gmail.com
ADMIN_PASSWORD=Axontech#2026!

# Google Gemini API key — needed for AI blog generation and AI reports
# Get yours free: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=


# ─── WHATSAPP BUSINESS API ────────────────────────────────
# Without these, the site works but no WhatsApp messages are sent
# Setup: https://business.whatsapp.com/developers/developer-hub

# Meta-provided long-lived access token
WHATSAPP_ACCESS_TOKEN=

# Your WhatsApp Business phone number ID (from Meta developer console)
WHATSAPP_PHONE_NUMBER_ID=

# Your number to receive order alerts (Kenyan format, no + sign)
WHATSAPP_ADMIN_NOTIFY_NUMBER=254745017979


# ─── SECURITY (OPTIONAL) ─────────────────────────────────

# Server-to-server API key — send header "x-admin-api-key: <value>" with requests
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# Comma-separated IPs allowed to access admin endpoints
# Leave empty to allow all IPs (rate limiting still applies)
# Example: ALLOWED_ADMIN_IPS=197.232.45.10,10.0.0.1
ALLOWED_ADMIN_IPS=
